declare/ display_taskmgr()          : level(5)
declare/ kill_selected_process()    : level(3)

// USER
CCP/ /SET.LEVEL = 3

// ---- LISTBOX ----

function/ display_taskmgr()
        // Create this in new process
        ccp/ /set.level = 2

        // Create new empty process
        @#taskmgr_pid_local sys/ /process taskmgr.cpc
        // Execute this function in this new process
        CMD/ /pid:%taskmgr_pid_local% /thread /F:__display_taskmgr()

end/ function

function/ __display_taskmgr()
	ccp/ /set.level = 3
        set/ TASKMGR_SELECTED_INDEX = -1
        set/ TASKMGR_KILL_PID = ""
        set/ TASKMGR_INTERACT = 0
        set/ TASKMGR_NEED_REFRESH = 0
        set/ TASKMGR_REFRESH_TICK = 0
	set/ TASKMGR_IDLE_MODE = 0
        set/ TASKMGR_RUN = 1
	ccp/ /set.level = 2

        // ===== Build window =====
        Window/ taskmgr_win
                .title          = "CPinti Core Task manager"
                .parameters     = "TYPE:0 SIZ:1 SIZBTN:1"
                .px             = "140"
                .py             = "100"
                .sx             = "450"
                .sy             = "250"
                .opacity        = "200"
                .WindowColor    = "100,100,100"
                .TitleColor     = "200,200,200"
                .backcolor      = "100,100,100"
                .icon           = "OS/MEDIA/GUI/taskm.png"
                .events         = "%_exe_path_%"

                @#window_handle create/
        End/ Window

        // Getting process list in Listbox format 
        @#list_process_listbox sys/ /process /listb

        // Getting icon process list in Listbox format
        @#list_icon_process_listbox sys/ /process /listb /icon

        // Cache initial rendered content to avoid useless redraw loops
        set/ TASKMGR_LAST_TEXT = %list_process_listbox%
        set/ TASKMGR_LAST_ICON = %list_icon_process_listbox%

        // ===== Build listbox =====
        listbox/ listbox_gui
                .handle         = "%window_handle%"
                .parameters     = "EXPLOREMODE:0 CTX:2"
                .px             = "1"
                .py             = "1"
                .sx             = "450"
                .sy             = "218"
                .opacity        = "255"
                .textcolor      = "028,028,028"
                .backcolor      = "255,255,255"
                .text           = "%list_process_listbox%"
                .Image          = "%list_icon_process_listbox%"
                .events         = "%_exe_path_%"
                create/
        End/ listbox

        // Refresh button
        Button/ taskmgr_refresh_btn
                .handle         = "%window_handle%"
                .Image          = "OS/MEDIA/GUI/BUTTONS/BTN_BLUE.PNG"
                .Parameters     = "IMGAUTO:2"
                .text           = "Rafraichir"
                .px             = "1"
                .py             = "222"
                .sx             = "160"
                .sy             = "26"
                .event          = "%_exe_path_%=MouseClick,Click"
                create/
        End/ Button

        // Kill button
        Button/ taskmgr_kill_btn
                .handle         = "%window_handle%"
                .Image          = "OS/MEDIA/GUI/BUTTONS/BTN_RED.PNG"
                .Parameters     = "IMGAUTO:2"
                .text           = "Arreter processus"
                .px             = "286"
                .py             = "222"
                .sx             = "160"
                .sy             = "26"
                .event          = "%_exe_path_%=MouseClick,Click"
                create/
        End/ Button

        ccp/ /set.level = 3

        // Recuperer la liste des nom de processus dans un tableau CpcdosC+
        sys/ /process /list /index /array list_process_pid

        // Config contextmenu
        set/ listbox_gui.ctx_text[0] = Arreter processus
        set/ listbox_gui.ctx_action[0] = /F:kill_selected_process()

        set/ listbox_gui.ctx_text[1] = Suspendre processus
        set/ listbox_gui.ctx_action[1] =  

        set/ listbox_gui.ctx_text[2] = Reprendre processus
        set/ listbox_gui.ctx_action[2] =  

        set/ listbox_gui.ctx_text[3] = Annuler
        set/ listbox_gui.ctx_action[3] =  


        set/ listbox_gui.ctx_number = 4

        // Auto-refresh: poll toutes les 500ms, actualisation réelle toutes les 5s (10 tics)
        // Apres un kill, TASKMGR_NEED_REFRESH=1 déclenche un refresh rapide (2 tics = 1s)
        :TASKMGR_REFRESH_LOOP:

        if/ "%TASKMGR_RUN%" != "1" then: Goto/ TASKMGR_EXIT

        // Si la fenetre principale n'existe plus, on arrete toute l'activite associee
        ccp/ /set.level = 2
        window/ /modif:taskmgr_win
                @#TASKMGR_WIN_HANDLE .handle
        end/ window
        ccp/ /set.level = 3
        if/ "%TASKMGR_WIN_HANDLE%" == "" then: Goto/ TASKMGR_EXIT
        if/ "%TASKMGR_WIN_HANDLE%" == "0" then: Goto/ TASKMGR_EXIT

        ccp/ /pause 500

        // Ne pas rafraichir si l'utilisateur interagit avec la liste
        if/ "%TASKMGR_INTERACT%" != "0" then: Goto/ TASKMGR_REFRESH_LOOP

        set/ TASKMGR_REFRESH_TICK = /C(%TASKMGR_REFRESH_TICK% + 1)

        // Refresh urgent apres un kill (attendre 2 tics = ~1s)
        if/ "%TASKMGR_NEED_REFRESH%" == "1" then:
                if/ "%TASKMGR_REFRESH_TICK%" >= "2" then:
                        set/ TASKMGR_NEED_REFRESH = 0
                        set/ TASKMGR_REFRESH_TICK = 0
                        EXE/ KRNL/CONFIG/ENV_GUI/TASKMGR.CPC /FN:taskmgr_refresh_list()
                End/ if
                Goto/ TASKMGR_REFRESH_LOOP
        End/ if

        // Refresh normal : 5s en mode actif, 30s en mode inactif (sans changement)
        set/ TASKMGR_REFRESH_LIMIT = 10
        if/ "%TASKMGR_IDLE_MODE%" == "1" then: set/ TASKMGR_REFRESH_LIMIT = 60

        if/ "%TASKMGR_REFRESH_TICK%" >= "%TASKMGR_REFRESH_LIMIT%" then:
                set/ TASKMGR_REFRESH_TICK = 0
                EXE/ KRNL/CONFIG/ENV_GUI/TASKMGR.CPC /FN:taskmgr_refresh_list()
        End/ if

        Goto/ TASKMGR_REFRESH_LOOP

        :TASKMGR_EXIT:
        set/ TASKMGR_RUN = 0
        ccp/ /set.level = 2
        close/ /PID %_EXE_PID_%

end/ function


// ===== GUI events =====

function/ taskmgr_win.WindowClosed()
        // Hard-stop loop and close all resources attached to this Taskmgr process
        ccp/ /set.level = 3
        set/ TASKMGR_RUN = 0

        // Fermer le process courant depuis le niveau process (2)
        ccp/ /set.level = 2
        close/ /pid:%_EXE_PID_%
end/ function

Function/ listbox_gui.selected(item_str,item_index)
        ccp/ /set.level = 3

        // Keep last explicit user selection for kill button fallback
        set/ TASKMGR_SELECTED_INDEX = %item_index%

end/ Function

Function/ listbox_gui.MouseEnter()
        set/ TASKMGR_INTERACT = 1
End/ Function

Function/ listbox_gui.MouseMove()
        set/ TASKMGR_INTERACT = 1
End/ Function

Function/ listbox_gui.MouseLeave()
        set/ TASKMGR_INTERACT = 0
End/ Function


Function/ kill_selected_process()
        ccp/ /set.level = 3


        // Getting item name
        @#item_index listbox/ /selected_index listbox_gui

        // Fallback to last selected item if current selection is transiently lost
        if/ "%item_index%" == "" then: set/ item_index = %TASKMGR_SELECTED_INDEX%
        if/ "%item_index%" == "-1" then: set/ item_index = %TASKMGR_SELECTED_INDEX%

        // Nothing selected or invalid PID mapping
        if/ "%item_index%" == "" then: Goto/ END_KILL_SELECTED_PROCESS
        if/ "%item_index%" == "-1" then: Goto/ END_KILL_SELECTED_PROCESS

        // Resolve target PID once to avoid context-sensitive re-evaluation issues
        set/ TASKMGR_KILL_PID = %list_process_pid[item_index]%
        if/ "%TASKMGR_KILL_PID%" == "" then: Goto/ END_KILL_SELECTED_PROCESS

        // Terminer le processus
        close/ /PID %TASKMGR_KILL_PID%

        // Invalider le cache et signaler à la boucle principale de rafraichir dans ~1s
        // On ne rappelle pas refresh() directement pour eviter l'execution concurrente
        set/ TASKMGR_LAST_TEXT = ""
        set/ TASKMGR_LAST_ICON = ""
        set/ TASKMGR_REFRESH_TICK = 0
        set/ TASKMGR_NEED_REFRESH = 1
        set/ TASKMGR_INTERACT = 0

        // Actualisation directe apres kill (fiabilise le bouton et le clic droit)
        ccp/ /pause 300
        EXE/ KRNL/CONFIG/ENV_GUI/TASKMGR.CPC /FN:taskmgr_refresh_list()

        :END_KILL_SELECTED_PROCESS:

End/ function

Function/ taskmgr_refresh_btn.MouseClick()
        ccp/ /set.level = 3
        set/ TASKMGR_LAST_TEXT = ""
        set/ TASKMGR_LAST_ICON = ""
        set/ TASKMGR_REFRESH_TICK = 0
        set/ TASKMGR_NEED_REFRESH = 1
        set/ TASKMGR_INTERACT = 0
        EXE/ KRNL/CONFIG/ENV_GUI/TASKMGR.CPC /FN:taskmgr_refresh_list()
End/ function

Function/ taskmgr_refresh_btn.Click()
        ccp/ /set.level = 3
        set/ TASKMGR_LAST_TEXT = ""
        set/ TASKMGR_LAST_ICON = ""
        set/ TASKMGR_REFRESH_TICK = 0
        set/ TASKMGR_NEED_REFRESH = 1
        set/ TASKMGR_INTERACT = 0
        EXE/ KRNL/CONFIG/ENV_GUI/TASKMGR.CPC /FN:taskmgr_refresh_list()
End/ function

Function/ taskmgr_kill_btn.MouseClick()
        ccp/ /set.level = 3
        set/ TASKMGR_INTERACT = 2
        /F:kill_selected_process()
End/ function

Function/ taskmgr_kill_btn.Click()
        ccp/ /set.level = 3
        set/ TASKMGR_INTERACT = 2
        /F:kill_selected_process()
End/ function

Function/ taskmgr_refresh_list()
        // This function refresh list

        ccp/ /set.level = 3

        // Preserve current user selection index before potential redraw
        @#item_index listbox/ /selected_index listbox_gui
        if/ "%item_index%" != "" then:
                if/ "%item_index%" != "-1" then:
                        ccp/ /set.level = 3
                        set/ TASKMGR_SELECTED_INDEX = %item_index%
                        ccp/ /set.level = 3
                End/ if
        End/ if

        // Getting process list in Listbox format 
        @#list_process_listbox sys/ /process /listb

        // Getting icon process list in Listbox format
        @#list_icon_process_listbox sys/ /process /listb /icon

        // Avoid hammering GUI memory map when nothing changed
        if/ "%list_process_listbox%" == "%TASKMGR_LAST_TEXT%" then:
                if/ "%list_icon_process_listbox%" == "%TASKMGR_LAST_ICON%" then:
                        set/ TASKMGR_IDLE_MODE = 1
                        Goto/ END_REFRESH
                End/ if
        End/ if
        
        listbox/ /modif:listbox_gui
                .text           = "%list_process_listbox%"
                .Image          = "%list_icon_process_listbox%"
                create/
        End/ listbox

        set/ TASKMGR_LAST_TEXT = %list_process_listbox%
        set/ TASKMGR_LAST_ICON = %list_icon_process_listbox%
        set/ TASKMGR_IDLE_MODE = 0

        ccp/ /set.level = 3
        sys/ /process /list /index /array list_process_pid
        set/ TASKMGR_INTERACT = 0

        :END_REFRESH:

End/ function

Function/ taskmgr_win.Resize(sizeup)
	// If user change window size

        // Getting window size informations
	window/ /modif:taskmgr_win
		@#Win_Size_X .sx
		@#Win_Size_Y .sy
	end/ window

        // Reserve space for kill button
        set/ List_Size_Y = /C(%Win_Size_Y% - 55)
        set/ Btn_Pos_X   = /C(%Win_Size_X% - 164)
        set/ Btn_Pos_Y   = /C(%Win_Size_Y% - 28)

        // And modify listbox object size
	listbox/ /modif:listbox_gui
		.sx     = "%Win_Size_X%"
                .sy     = "%List_Size_Y%"
		create/
	end/ listbox

        button/ /modif:taskmgr_kill_btn
                .px     = "%Btn_Pos_X%"
                .py     = "%Btn_Pos_Y%"
                create/
        end/ button

        button/ /modif:taskmgr_refresh_btn
                .py     = "%Btn_Pos_Y%"
                create/
        end/ button

End/ function














